[Unit]
Description=WeeWX weather archive and Belchertown reports for iTuner
Wants=ituner-weather-web.service
After=network.target ituner-weather-web.service

[Service]
Type=simple
User=ituner
Environment=TZ=Europe/Bucharest
ExecStart=/opt/ituner-sdr/weather/venv/bin/weewxd /var/lib/ituner-weather/weewx.conf
Restart=on-failure
RestartSec=10
StateDirectory=ituner-weather
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
DevicePolicy=closed
UMask=0022

[Install]
WantedBy=multi-user.target

#!/usr/bin/env python3
"""Small root-only NetworkManager bridge for the iTuner touch UI."""

import json
import ipaddress
import subprocess
import sys
from pathlib import Path


WLAN_DEVICE = "wlan0"
PROFILE_PREFIX = "iTuner Wi-Fi "


def run(*args, timeout=35):
    return subprocess.run(
        ["nmcli", *args],
        text=True,
        capture_output=True,
        timeout=timeout,
        check=False,
    )


def message(result, fallback):
    text = (result.stderr or result.stdout or fallback).strip()
    # Do not reflect an entered passphrase to the unprivileged UI process.
    return text.replace("password", "Wi-Fi key")


def json_reply(payload, exit_code=0):
    print(json.dumps(payload, separators=(",", ":")))
    raise SystemExit(exit_code)


def connection_exists(name):
    return run("-g", "UUID", "connection", "show", name, timeout=8).returncode == 0


def profile_name(ssid):
    return f"{PROFILE_PREFIX}{ssid}"


def ensure_persistent_profile(ssid, password, saved_uuid=None, open_network=False):
    name = profile_name(ssid)
    if password and not 8 <= len(password) <= 63:
        return None, "Enter a password with 8–63 characters."
    saved_uuid = saved_uuid or saved_networks().get(ssid)
    if saved_uuid:
        check = run("-e", "no", "-g", "802-11-wireless.ssid", "connection", "show", "uuid", saved_uuid, timeout=8)
        if check.returncode or check.stdout.rstrip("\n") != ssid:
            return None, "Saved network no longer matches. Scan again."
        target = ("uuid", saved_uuid)
    else:
        if not open_network and not password:
            return None, "Enter a password with 8–63 characters."
        target = None
    current = run("-g", "GENERAL.CON-UUID", "device", "show", WLAN_DEVICE, timeout=8).stdout.strip()
    current_ssid = run("-e", "no", "-g", "802-11-wireless.ssid", "connection", "show", "uuid", current, timeout=8).stdout.rstrip("\n") if current and current != "--" else ""
    # An explicitly entered replacement key always wins, including saved UUIDs.
    if target and password and not open_network:
        result = run("connection", "modify", *target, "802-11-wireless-security.psk", password,
                     "802-11-wireless-security.psk-flags", "0", timeout=15)
        if result.returncode:
            return None, "Could not save the Wi-Fi password."
    switched = bool(current_ssid and current_ssid != ssid)
    if switched:
        if run("--wait", "15", "connection", "down", "uuid", current, timeout=20).returncode:
            return None, "Could not disconnect the current access point."
    def failed():
        if switched:
            try:
                run("--wait", "20", "connection", "up", "uuid", current, "ifname", WLAN_DEVICE, timeout=25)
            except (OSError, subprocess.SubprocessError):
                pass
        return None, "Could not connect. Check the password and signal, then try again."
    try:
        run("radio", "wifi", "on", timeout=8)
        if target is None:
            args = ["--wait", "30", "device", "wifi", "connect", ssid, "ifname", WLAN_DEVICE, "name", name]
            if not open_network:
                args += ["password", password]
            if run(*args, timeout=38).returncode:
                return failed()
            target = ("id", name)
        result = run("connection", "modify", *target,
                     "connection.permissions", "", "connection.autoconnect", "yes",
                     "connection.autoconnect-priority", "100", "ipv4.route-metric", "50", "ipv6.route-metric", "50", timeout=15)
        if result.returncode:
            return failed()
        run("device", "set", WLAN_DEVICE, "managed", "yes", timeout=8)
        run("device", "set", WLAN_DEVICE, "autoconnect", "yes", timeout=8)
        if run("--wait", "30", "connection", "up", *target, "ifname", WLAN_DEVICE, timeout=38).returncode:
            return failed()
    except (OSError, subprocess.SubprocessError):
        return failed()
    return name, f"Connected to {ssid}. Saved for automatic reconnection."


def split_nmcli(line):
    """nmcli escapes colons and backslashes in SSIDs and connection names."""
    fields, value, escaped = [], "", False
    for char in line:
        if escaped:
            value += char
            escaped = False
        elif char == "\\":
            escaped = True
        elif char == ":":
            fields.append(value)
            value = ""
        else:
            value += char
    fields.append(value)
    return fields


def saved_networks():
    result = run("-t", "-f", "UUID,TYPE", "connection", "show", timeout=8)
    saved = {}
    for line in result.stdout.splitlines():
        fields = split_nmcli(line)
        if len(fields) != 2 or fields[1] != "802-11-wireless":
            continue
        ssid = run("-e", "no", "-g", "802-11-wireless.ssid", "connection", "show", "uuid", fields[0], timeout=8)
        if ssid.returncode == 0:
            saved[ssid.stdout.rstrip("\n")] = fields[0]
    return saved


def wifi_countries():
    try:
        rows = Path("/usr/share/zoneinfo/iso3166.tab").read_text().splitlines()
    except OSError:
        return [{"code": "US", "name": "United States"}, {"code": "RO", "name": "Romania"}]
    countries = []
    for row in rows:
        if row and not row.startswith("#"):
            code, name = row.split("\t", 1)
            countries.append({"code": code, "name": name})
    return sorted(countries, key=lambda c: (c["code"] not in ("US", "RO"), c["name"]))


def wifi_country():
    try:
        result = subprocess.run(["raspi-config", "nonint", "get_wifi_country"],
                                text=True, capture_output=True, timeout=8, check=False)
        return result.stdout.strip() if result.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def set_wifi_country(code):
    if code not in {c["code"] for c in wifi_countries()}:
        return {"ok": False, "error": "Choose a valid Wi-Fi country."}
    try:
        result = subprocess.run(["raspi-config", "nonint", "do_wifi_country", code],
                                text=True, capture_output=True, timeout=30, check=False)
    except (OSError, subprocess.SubprocessError):
        return {"ok": False, "error": "Wi-Fi country setup is unavailable on this system."}
    if result.returncode:
        return {"ok": False, "error": "Could not change the Wi-Fi country."}
    return {"ok": True, "country": code,
            "message": f"Wi-Fi country set to {code}. Scan again; a reboot may be needed."}


def network_status():
    devices = {}
    result = run("-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status", timeout=10)
    for line in result.stdout.splitlines():
        parts = split_nmcli(line)
        if len(parts) != 4 or parts[0] not in ("eth0", WLAN_DEVICE):
            continue
        device, _kind, state, connection = parts
        addresses = run("-g", "IP4.ADDRESS", "device", "show", device, timeout=8).stdout.splitlines()
        devices[device] = {
            "state": state,
            "connection": connection or "NOT CONNECTED",
            "addresses": [address.split("/", 1)[0] for address in addresses if address],
        }
        if device == WLAN_DEVICE and state == "connected":
            connected = run("-e", "no", "-g", "802-11-wireless.ssid", "connection", "show", "id", connection, timeout=8)
            if connected.returncode == 0:
                devices[device]["ssid"] = connected.stdout.rstrip("\n")
    return {"ok": result.returncode == 0, "devices": devices, "country": wifi_country(), "countries": wifi_countries()}


def scan_networks():
    result = run(
        "-t",
        "-f",
        "IN-USE,SSID,SECURITY,SIGNAL",
        "device",
        "wifi",
        "list",
        "ifname",
        WLAN_DEVICE,
        "--rescan",
        "yes",
        timeout=25,
    )
    networks = []
    saved = saved_networks()
    for line in result.stdout.splitlines():
        parts = split_nmcli(line)
        if len(parts) != 4:
            continue
        active, ssid, security, signal = parts
        if not ssid:
            continue
        try:
            strength = int(signal)
        except ValueError:
            strength = 0
        networks.append({"ssid": ssid, "security": security, "signal": strength, "active": active == "*", "saved_uuid": saved.get(ssid)})
    networks.sort(key=lambda n: (not n["active"], -n["signal"], n["ssid"].casefold()))
    unique = {}
    for network in networks:
        unique.setdefault(network["ssid"], network)
    return {"ok": result.returncode == 0, "networks": list(unique.values()), "message": "Wi-Fi scan complete."}


def manage_saved_network(action, payload):
    ssid = str(payload.get("ssid") or "")
    uuid = str(payload.get("saved_uuid") or "")
    if not ssid or not uuid:
        return {"ok": False, "error": "Network details changed. Scan again."}
    check = run("-e", "no", "-g", "802-11-wireless.ssid", "connection", "show", "uuid", uuid, timeout=8)
    if check.returncode or check.stdout.rstrip("\n") != ssid:
        return {"ok": False, "error": "Saved network no longer matches. Scan again."}
    if action == "disconnect":
        current = run("-g", "GENERAL.CON-UUID", "device", "show", WLAN_DEVICE, timeout=8)
        if current.returncode or current.stdout.strip() != uuid:
            return {"ok": False, "error": "This network is no longer connected."}
        # Device disconnect suppresses automatic reconnection until the user
        # explicitly connects again (or reboots), without deleting the profile.
        result = run("--wait", "15", "device", "disconnect", WLAN_DEVICE, timeout=20)
        message = "Disconnected. Password kept; tap the saved network to reconnect."
    elif action == "forget":
        result = run("connection", "delete", "uuid", uuid, timeout=15)
        message = "Saved network removed. Select it to set up a connection again."
    else:
        return {"ok": False, "error": "Unsupported network request."}
    if result.returncode:
        return {"ok": False, "error": "Could not change this network. Please try again."}
    response = network_status()
    response.update(ok=True, message=message)
    if action == "forget":
        response["forgotten_uuid"] = uuid
    return response



def interface_profile(device):
    if device not in ('wlan0', 'eth0'):
        raise ValueError('Unknown network interface')
    current = run('-g', 'GENERAL.CON-UUID', 'device', 'show', device, timeout=8).stdout.strip()
    if current and current != '--':
        return current
    profiles = run('-t', '-f', 'UUID,TYPE', 'connection', 'show', timeout=8)
    expected = '802-11-wireless' if device == 'wlan0' else '802-3-ethernet'
    for line in profiles.stdout.splitlines():
        parts = split_nmcli(line)
        if len(parts) != 2 or parts[1] != expected: continue
        bound = run('-g', 'connection.interface-name', 'connection', 'show', 'uuid', parts[0], timeout=8).stdout.strip()
        if bound in ('', '--', device): return parts[0]
    return None


def interface_settings(payload):
    device = payload.get('device')
    try: uid = interface_profile(device)
    except ValueError as exc: return dict(ok=False, error=str(exc))
    data = dict(device=device, uuid=uid, method='auto', addresses='', gateway='', dns='', autoneg=True, speed=0, duplex='full')
    if uid:
        for key, prop in (('method','ipv4.method'),('addresses','ipv4.addresses'),('gateway','ipv4.gateway'),('dns','ipv4.dns')):
            value = run('-g', prop, 'connection','show','uuid',uid,timeout=8).stdout.strip()
            data[key] = '' if value == '--' else value
        if device == 'eth0':
            for key, prop in (('autoneg','802-3-ethernet.auto-negotiate'),('speed','802-3-ethernet.speed'),('duplex','802-3-ethernet.duplex')):
                value=run('-g',prop,'connection','show','uuid',uid,timeout=8).stdout.strip()
                data[key]=value == 'yes' if key=='autoneg' else int(value or 0) if key=='speed' else value or 'full'
    return dict(ok=True, interface=data)


def configure_interface(payload):
    device=payload.get('device')
    if device not in ('wlan0','eth0'):return dict(ok=False,error='Unknown network interface')
    # Validate all user input before changing a profile or disconnecting anything.
    mode=payload.get('method','auto');operation=payload.get('operation','apply')
    if operation not in ('apply','off','on'):return dict(ok=False,error='Unknown interface action')
    if mode not in ('auto','manual'):return dict(ok=False,error='Choose DHCP or Static')
    address=str(payload.get('addresses','')).strip();gateway=str(payload.get('gateway','')).strip();dns=str(payload.get('dns','')).strip()
    if operation=='apply' and mode=='manual':
        try:
            if '/' not in address:raise ValueError('Use an IPv4 address with prefix, e.g. 192.168.1.20/24')
            ipaddress.IPv4Interface(address)
            if gateway:ipaddress.IPv4Address(gateway)
            for value in dns.replace(',', ' ').split():ipaddress.IPv4Address(value)
        except ValueError as exc:return dict(ok=False,error=str(exc))
    speed=payload.get('speed',0);autoneg=payload.get('autoneg',True);duplex=payload.get('duplex','full')
    if device=='eth0' and (type(speed) is not int or speed not in (0,10,100,1000) or type(autoneg) is not bool or duplex not in ('full','half') or (not autoneg and speed==0)):
        return dict(ok=False,error='Choose a valid Ethernet speed, duplex and negotiation mode')
    uid=interface_profile(device)
    if payload.get('uuid') and payload['uuid'] != uid:
        return dict(ok=False,error='The active connection changed. Reopen interface settings.')
    if operation=='off':
        if uid and run('connection','modify','uuid',uid,'connection.autoconnect','no',timeout=15).returncode:
            return dict(ok=False,error='Could not disable automatic connection')
        result=run('radio','wifi','off',timeout=10) if device=='wlan0' else run('--wait','15','device','disconnect',device,timeout=20)
    else:
        if not uid:return dict(ok=False,error='Connect to an access point first' if device=='wlan0' else 'No Ethernet profile found')
        if device=='wlan0':run('radio','wifi','on',timeout=10)
        args=['connection','modify','uuid',uid,'connection.autoconnect','yes']
        if operation=='apply':
            args += ['ipv4.method',mode,'ipv4.addresses',address if mode=='manual' else '', 'ipv4.gateway',gateway if mode=='manual' else '', 'ipv4.dns',','.join(dns.replace(',', ' ').split()) if mode=='manual' else '', 'ipv4.ignore-auto-dns','yes' if mode=='manual' and dns else 'no']
            if device=='eth0':args += ['802-3-ethernet.auto-negotiate','yes' if autoneg else 'no','802-3-ethernet.speed',str(speed),'802-3-ethernet.duplex',duplex if speed else '']
        if run(*args,timeout=15).returncode:return dict(ok=False,error='Could not save interface settings')
        result=run('--wait','30','connection','up','uuid',uid,'ifname',device,timeout=38)
    if result.returncode:return dict(ok=False,error='Could not apply interface settings. Check the address and link.')
    response=network_status();response.update(ok=True,message='Interface turned off.' if operation=='off' else 'Interface settings applied.')
    return response

def main():
    if len(sys.argv) != 2 or sys.argv[1] not in {"status", "scan", "connect", "country", "disconnect", "forget", "interface", "configure-interface"}:
        json_reply({"ok": False, "error": "Unsupported network request."}, 2)
    action = sys.argv[1]
    if action == "status":
        response = network_status()
        response["message"] = "Network status updated."
        json_reply(response, 0 if response["ok"] else 1)
    if action == "scan":
        response = scan_networks()
        json_reply(response, 0 if response["ok"] else 1)

    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, TypeError):
        json_reply({"ok": False, "error": "Invalid Wi-Fi request."}, 2)
    if action in ("interface", "configure-interface"):
        response = interface_settings(payload) if action == "interface" else configure_interface(payload)
        json_reply(response, 0 if response["ok"] else 1)
    if action in ("disconnect", "forget"):
        response = manage_saved_network(action, payload)
        json_reply(response, 0 if response["ok"] else 1)
    if action == "country":
        response = set_wifi_country(str(payload.get("country") or ""))
        json_reply(response, 0 if response["ok"] else 1)
    ssid = str(payload.get("ssid") or "")
    password = str(payload.get("password") or "")
    if not ssid:
        json_reply({"ok": False, "error": "Choose a Wi-Fi network."}, 2)
    name, result_message = ensure_persistent_profile(ssid, password, payload.get("saved_uuid"), payload.get("open") is True)
    if name is None:
        json_reply({"ok": False, "error": result_message}, 1)
    response = network_status()
    response.update({"ok": True, "message": result_message, "profile": name, "connected_ssid": ssid})
    json_reply(response)


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.SubprocessError, ValueError):
        json_reply(dict(ok=False,error="Network request failed. Check the connection and try again."), 1)

[Unit]
Description=iTuner Weather source and Belchertown web interface
Wants=ituner-sdr.service
After=network.target ituner-sdr.service

[Service]
Type=simple
User=ituner
Environment=TZ=Europe/Bucharest
ExecStart=/usr/bin/python3 /opt/ituner-sdr/weather/integration/weather_server.py
Restart=on-failure
RestartSec=5
StateDirectory=ituner-weather
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
DevicePolicy=closed
UMask=0022

[Install]
WantedBy=multi-user.target

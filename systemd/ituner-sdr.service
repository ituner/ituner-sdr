[Unit]
Description=iTuner SDR OpenGL touchscreen radio UI
After=network-online.target sound.target ituner-sdr-touch-ready.service
Wants=network-online.target

[Service]
Type=simple
User=__ITUNER_SDR_USER__
SupplementaryGroups=video input render audio
WorkingDirectory=/opt/ituner-sdr/UI
EnvironmentFile=/etc/ituner-sdr.conf
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1
Environment=XDG_RUNTIME_DIR=/run/user/__ITUNER_SDR_UID__
ExecStart=/usr/local/lib/ituner-sdr/start-opengl.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
